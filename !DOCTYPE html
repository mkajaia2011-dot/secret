<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧪 საიდუმლო წერილები - ქიმიური ანიმაცია</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: #090d16;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        h1 {
            color: #38bdf8;
            margin-bottom: 8px;
            text-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
            text-align: center;
        }

        p.subtitle {
            color: #94a3b8;
            margin-bottom: 25px;
            text-align: center;
        }

        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
            width: 100%;
            max-width: 900px;
        }

        .card {
            background: #0f172a;
            border: 2px solid #1e293b;
            border-radius: 20px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            transition: all 0.3s ease;
        }

        .card:hover {
            border-color: #38bdf8;
            box-shadow: 0 12px 30px rgba(56, 189, 248, 0.2);
        }

        .card h2 {
            font-size: 18px;
            color: #f1f5f9;
            margin-bottom: 15px;
            text-align: center;
        }

        /* ქაღალდის დაფა */
        .paper-board {
            width: 100%;
            height: 180px;
            background: #f8fafc;
            border-radius: 12px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.15);
        }

        /* საიდუმლო ტექსტები */
        .secret-text {
            font-size: 36px;
            font-weight: 900;
            letter-spacing: 4px;
            user-select: none;
            transition: color 1.5s ease, opacity 1.5s ease, text-shadow 1.5s ease;
            opacity: 0;
        }

        /* 1. ფენოლფტალეინი + ტუტე -> ჟოლოსფერი */
        .phenolphthalein {
            color: transparent;
        }
        .phenolphthalein.revealed {
            opacity: 1;
            color: #e11d48; /* ჟოლოსფერი / Magenta */
            text-shadow: 0 0 10px rgba(225, 29, 72, 0.5);
        }

        /* 2. სახამებელი + იოდი -> მუქი ლურჯი */
        .starch {
            color: transparent;
        }
        .starch.revealed {
            opacity: 1;
            color: #1e1b4b; /* მუქი ლურჯი / ინდიგო */
            text-shadow: 0 0 12px rgba(30, 27, 75, 0.6);
        }

        /* შესხურების პულვერიზატორი (Spray animation) */
        .spray-bottle {
            position: absolute;
            top: 15px;
            right: 15px;
            font-size: 24px;
            opacity: 0.3;
            transition: all 0.3s;
        }

        .spray-particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .particle {
            position: absolute;
            border-radius: 50%;
            opacity: 0;
            animation: sprayEffect 0.8s ease-out forwards;
        }

        @keyframes sprayEffect {
            0% { transform: scale(0.2); opacity: 0.8; }
            100% { transform: scale(2); opacity: 0; }
        }

        .btn-group {
            display: flex;
            gap: 8px;
            margin-top: 18px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* ღილაკები */
        .action-btn {
            background: linear-gradient(135deg, #0284c7, #38bdf8);
            color: #fff;
            border: none;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(56, 189, 248, 0.5);
        }

        .reset-btn {
            background: rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            border: 1px solid #334155;
            padding: 10px 14px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .reset-btn:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        .description {
            margin-top: 12px;
            font-size: 13px;
            color: #94a3b8;
            text-align: center;
            line-height: 1.4;
        }

        .description b {
            color: #38bdf8;
        }
    </style>
</head>
<body>

    <h1>🧪 "საიდუმლო წერილის" აღმოჩენა</h1>
    <p class="subtitle">დააჭირე შესხურების ღილაკს და დააკვირდი ინდიკატორების რეაქციას</p>

    <div class="container">

        <!-- 1. ფენოლფტალეინი + ტუტე -->
        <div class="card">
            <h2>1. ფენოლფტალეინით დაწერილი სიტყვა</h2>
            <div class="paper-board" id="board1">
                <div class="spray-bottle">💨</div>
                <div class="secret-text phenolphthalein" id="text1">ქიმია</div>
                <div class="spray-particles" id="particles1"></div>
            </div>
            <div class="btn-group">
                <button class="action-btn" onclick="revealSecret(1, '#f43f5e')">🚿 ტუტის ხსნარის შესხურება</button>
                <button class="reset-btn" onclick="resetSecret(1)">🔄 გასუფთავება</button>
            </div>
            <p class="description">
                <b>მოვლენა:</b> უფერო ფენოლფტალეინი ტუტე არეში (NaOH) იცვლის ფერს და ხდება <b>ჟოლოსფერი</b>.
            </p>
        </div>

        <!-- 2. სახამებელი + იოდი -->
        <div class="card">
            <h2>2. სახამებლით დაწერილი სიტყვა</h2>
            <div class="paper-board" id="board2">
                <div class="spray-bottle">💨</div>
                <div class="secret-text starch" id="text2">რეაქცია</div>
                <div class="spray-particles" id="particles2"></div>
            </div>
            <div class="btn-group">
                <button class="action-btn" onclick="revealSecret(2, '#7c2d12')">🚿 იოდის ხსნარის შესხურება</button>
                <button class="reset-btn" onclick="resetSecret(2)">🔄 გასუფთავება</button>
            </div>
            <p class="description">
                <b>მოვლენა:</b> სახამებლისა და იოდის ურთიერთქმედებით წარმოიქმნება <b>მუქი ლურჯი</b> კომპლექსური ნაერთი.
            </p>
        </div>

    </div>

    <script>
        function revealSecret(id, particleColor) {
            const textElement = document.getElementById(`text${id}`);
            const particlesContainer = document.getElementById(`particles${id}`);

            // ტექსტის გამოჩენა
            textElement.classList.add('revealed');

            // შესხურების (წვეთების) ანიმაციის გენერირება
            for (let i = 0; i < 30; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                
                // შემთხვევითი ზომები და პოზიციები
                const size = Math.random() * 14 + 6;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.background = particleColor;
                
                particle.style.left = `${Math.random() * 84 + 8}%`;
                particle.style.top = `${Math.random() * 80 + 10}%`;
                
                particlesContainer.appendChild(particle);

                // ანიმაციის დასრულების შემდეგ წაშლა
                setTimeout(() => {
                    particle.remove();
                }, 800);
            }
        }

        function resetSecret(id) {
            const textElement = document.getElementById(`text${id}`);
            textElement.classList.remove('revealed');
        }
    </script>
</body>
</html>
